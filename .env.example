# Copy this file to .env.local and fill in your own Web3Forms access key.
# Get a free key (no account needed) at https://web3forms.com/ — it just
# emails you the key instantly. .env.local is already git-ignored (see
# .gitignore's `*.local` rule), so your key never gets committed.
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here
